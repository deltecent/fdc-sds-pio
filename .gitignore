.pio/
.vscode/
.DS_Store
*.bin
*.elf
*.map

# The ota/ payload must be tracked so raw.githubusercontent.com can serve it from
# master (DESIGN.md §11.1) and users can download it: firmware.bin (network OTA / SD
# update) and merged.bin (full-flash image for esptool / the Flash Download Tool).
# Exempt both from the *.bin rule above. See tools/build-ota.sh.
!ota/firmware.bin
!ota/merged.bin

# ESP-IDF / PlatformIO generated config (regenerated from sdkconfig.defaults).
# Keep sdkconfig.defaults tracked; ignore the live sdkconfig and per-env copies.
sdkconfig
sdkconfig.*
!sdkconfig.defaults

# CMake entry points auto-generated by PlatformIO's ESP-IDF integration
# ("automatically generated for projects without default CMakeLists.txt").
# Regenerated on a fresh checkout; not hand-maintained.
/CMakeLists.txt
/src/CMakeLists.txt

# Managed components pulled from the ESP Component Registry per src/idf_component.yml
# (e.g. espressif/mdns) and the generated solver lock — both reproducible from the manifest.
managed_components/
dependencies.lock

# Python
__pycache__/
*.pyc
