# ESP-IDF build defaults for the FDC+ Serial Disk Server (M0 baseline).
#
# PlatformIO regenerates sdkconfig from this file; edit here, not sdkconfig
# (which is git-ignored). Tuned further at M4 (FDC timing) per the build plan.

# Run the CPU at full speed — high-baud FDC UART + inline SD track I/O.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Console on UART0 (USB) at 115200 8N1 (DESIGN.md §2.1).
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# Keep both cores (default): the fdc task pins to core 1, net/cli live on core 0
# (DESIGN.md §5.2). A 1 kHz tick gives finer resolution for FDC timeouts/LEDs.
CONFIG_FREERTOS_HZ=1000

# FATFS long filenames (DESIGN.md §10: image names up to 64 chars). Without this,
# readdir/open only see mangled 8.3 names (CPM22-~1.DSK) and `mount <longname>`
# fails. LFN buffer on the heap (not the stack); 255-char max covers our names.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Network OTA (DESIGN.md §11.1): esp_https_ota validates the release server's TLS cert
# against the bundled CA roots (esp_crt_bundle) rather than a pinned cert. The bundle is
# on by default; make it explicit and use the full root set so raw.githubusercontent.com
# (and any CDN it fronts) verifies.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
